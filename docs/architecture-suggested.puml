@startuml architecture-suggested
title Mixer — Suggested Architecture (DMX domain on lib/Utils, effects omitted)

skinparam classAttributeIconSize 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 12
skinparam ranksep 45
top to bottom direction
skinparam class {
    BackgroundColor White
    BorderColor #2C3E50
}

legend top
  + public   # protected   - private   {static} {abstract}
  Grey = existing lib/Utils foundation (reused; members hidden).
  White = Mixer DMX domain to (re)build on it.
  <<NEW>> = type proposed here that does not exist yet.
  (Effects layer intentionally omitted in this revision.)
endlegend

' =======================================================================
' lib/Utils — FOUNDATION (already exists; class names only, no members)
' =======================================================================
package "lib/Utils :: foundation" #EEEEEE {
    interface "Traits::Stringify" as Stringify
    class "Utils::Fragment" as Fragment
    class "Utils::FragmentedStorage<T,TSize>" as FragmentedStorage
    class "Colors::RGB" as RGB
    class "Colors::HSV" as HSV
    class "Network::SacnSender" as SacnSender
    class "Network::IP" as IP
    class "Network::Interfaces" as Interfaces
    class "Time::Timer" as Timer
    class "Utils::Logger" as Logger
    class "Utils::String" as UString
    class "File" as File
    class "Regex::Matcher" as Matcher
}

